# Contact form settings. Copy to .env.local (gitignored) for local testing, and add the same
# variables in Vercel → Project → Settings → Environment Variables for production.
# Without them, local development still works: messages are logged instead of sent, and
# Cloudflare's always-pass test keys are used for the bot check.

# --- Where messages go (server-only; never shown on the site) ---
CONTACT_TO=
# Sender address. Most providers require it to be the authenticated mailbox (SMTP_USER) or an alias of it.
CONTACT_FROM=

# --- SMTP: the outgoing mail server of the mailbox behind info@sunnyprakash.com ---
# Find these in your mail provider's "SMTP" / "mail client setup" help page.
SMTP_HOST=
# 465 = TLS (recommended). 587 = STARTTLS. Other ports are not supported.
SMTP_PORT=465
SMTP_USER=
# Use an app-specific password if your provider offers one, not your main login password. To regenerate the password, go to https://login.yahoo.com/myaccount/overview → Account Security → Generate app password → Other App → Enter a name → Generate. Copy the generated password and paste it here.
SMTP_PASS=

# --- Cloudflare Turnstile (bot check): https://dash.cloudflare.com → Turnstile → Add widget ---
# Add your domain (sunnyprakash.com) and "localhost"; choose "Managed" mode.
# Site key is public by design (it's embedded in the page); the secret key must stay private.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
